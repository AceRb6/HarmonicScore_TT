# ============================================================
# Plantilla de Configuracion de Gmail SMTP (CU-03: Recuperacion de contrasena)
# Copia este archivo como ".env.correo" y coloca la contrasena de aplicacion real.
# El archivo ".env.correo" esta en .gitignore y NO debe subirse a GitHub.
# ============================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=harmonicscore.escom@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_aqui
DEFAULT_FROM_EMAIL=Harmonic Score <harmonicscore.escom@gmail.com>
SITE_URL=
