# ============================================================
# Configuracion de red — Harmonic Score
# ============================================================
# IP de la maquina que corre el ml-service (FastAPI, puerto 8000).
# Obtenla en ESA maquina con:  ipconfig  (Direccion IPv4)
# IMPORTANTE: no uses 127.0.0.1 aqui; dentro del contenedor eso
# apunta al propio contenedor, no a la otra computadora.
# Adicionalmente, esto debe cambiarse a la ip de la computadora que corre el ml-service, si es que se cambia de computadora.
ML_SERVICE_URL=http://192.168.1.68:8000
